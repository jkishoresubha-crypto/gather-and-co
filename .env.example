# Copy to .env for LOCAL development only. Never commit .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# PostgreSQL (required when DJANGO_DEBUG=False). Leave empty locally to use SQLite.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# MongoDB Atlas (chat logs + feedback). Optional: the site works without it.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=gather_co
# AI provider (OpenAI Chat Completions). Optional: FAQ fallback is used without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OpenWeather (home page weather card). Optional.
OPENWEATHER_API_KEY=
DEFAULT_WEATHER_CITY=London
# Demo account passwords used by `manage.py seed_demo` (only applied when the accounts are first created)
DEMO_OWNER_PASSWORD=GatherOwner#2026
DEMO_CUSTOMER_PASSWORD=GatherGuest#2026
PORT=8000
